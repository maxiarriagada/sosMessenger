; LoRaMessenger - PlatformIO project
; Env hub: ESP32-S3, AP + webapp + GPS + ESP-NOW
; Env node: ESP32, GPS + ESP-NOW

[platformio]
default_envs = hub

[env]
platform = espressif32
framework = arduino
monitor_speed = 115200
monitor_filters = esp32_exception_decoder
board_build.filesystem = littlefs
build_unflags = -std=gnu++11
build_flags =
    -std=gnu++17
    -Wall
    -Wextra
lib_deps =
    bblanchon/ArduinoJson@^7.4.0
    mikalhart/TinyGPSPlus@^1.0.3
    mathieucarbou/ESPAsyncWebServer@^3.6.0
    mathieucarbou/AsyncTCP@^3.3.2

[env:hub]
board = esp32-s3-devkitc-1
board_build.flash_size = 8MB
board_build.partitions = partitions_hub.csv
build_flags =
    ${env.build_flags}
    -DROLE_HUB=1
    -DROLE_NODE=0

[env:hub32]
; Temporary hub role on a classic ESP32 (4 MB) for early web/portal testing.
board = esp32dev
board_build.flash_size = 4MB
board_build.partitions = partitions_hub32.csv
build_flags =
    ${env.build_flags}
    -DROLE_HUB=1
    -DROLE_NODE=0
    -DLM_TLS_SPIKE=1

[env:node]
board = esp32dev
board_build.partitions = partitions_node.csv
build_flags =
    ${env.build_flags}
    -DROLE_HUB=0
    -DROLE_NODE=1
build_src_filter = +<*> -<web_server.cpp> -<wifi_ap.cpp> -<captive_portal.cpp> -<auth.cpp> -<location.cpp>
lib_deps =
    bblanchon/ArduinoJson@^7.4.0
    mikalhart/TinyGPSPlus@^1.0.3
